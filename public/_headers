# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Self-hosted OCR runtime. The spec forbids a CDN fallback (§2, §8): the app
# must make no network request after its own assets load. ~27MB, versioned by
# the tesseract.js release, so it is safe to cache immutably.
/tesseract/*
  Cache-Control: public,max-age=31536000,immutable

# eng.traineddata.gz is gzip *content*, not a gzip-encoded response.
# Without this, an edge that sets Content-Encoding: gzip causes the browser to
# decompress it once and tesseract.js to try again on the plaintext.
/tesseract/eng.traineddata.gz
  Content-Type: application/octet-stream
  Cache-Control: public,max-age=31536000,immutable
